# Copy is created for you by `blackbox init`. Never commit .env.
BLACKBOX_ADMIN_TOKEN=
BLACKBOX_HOST=127.0.0.1
BLACKBOX_PORT=8377
BLACKBOX_DB=data/blackbox.db
# Redact emails (local part), phone numbers, long digit runs and API-key-like strings before storing
BLACKBOX_REDACT=true
BLACKBOX_MAX_BODY_KB=256
BLACKBOX_RATE_LIMIT_PER_MIN=300
BLACKBOX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Seconds an agent waits for a human before the call is denied by default
BLACKBOX_APPROVAL_TIMEOUT_S=300
# Optional Telegram approvals (leave empty to use the dashboard only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
